+constexpr const char* kResolutionNames[] = {"Auto (fits window)", "Native 1x (accurate)", "2x",
+                                            "3x", "4x", "5x", "6x", "8x"};
+constexpr int kResolutionScales[] = {0, 1, 2, 3, 4, 5, 6, 8};
+constexpr const char* kFrameRateNames[] = {"Original 60 (accurate)", "120 (2x)", "180 (3x)",
