+    if (!qexe || !qimage || !qout) {
+        free(qexe); free(qimage); free(qout);
+        return 0;
+    }
+    const char* args[] = {qexe, "extract", "--native-only", qimage, qout, NULL};
+    int ok = _spawnv(_P_WAIT, extractor, args) == 0;
+    free(qexe); free(qimage); free(qout);
+    return ok;
 #else
     char* qexe = quote_arg(extractor);
     char* qimage = quote_arg(image);
