+#ifdef _WIN32
+static char* quote_spawn_arg(const char* arg) {
+    size_t len = strlen(arg), w = 0, slashes = 0;
+    char* out = (char*)malloc(len * 2 + 3);
+    if (!out) return NULL;
+    out[w++] = '"';
+    for (size_t i = 0; ; ++i) {
+        char c = arg[i];
+        if (c == '\\') { ++slashes; continue; }
+        size_t n = (c == '"' || c == '\0') ? slashes * 2 : slashes;
+        while (n--) out[w++] = '\\';
+        slashes = 0;
+        if (c == '\0') break;
+        if (c == '"') out[w++] = '\\';
+        out[w++] = c;
+    }
+    out[w++] = '"';
+    out[w] = '\0';
+    return out;
+}
+#endif
