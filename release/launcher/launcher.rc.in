// WarioWorldRecomp.exe resources (configured by CMake): the original coin icon (drawn by make_exe_icon.py at build
// time), the default controller profile and the version block. The manifest is embedded by the
// linker (CMakeLists.txt).
#include <winres.h>
#include "resource.h"

IDI_APP ICON "@EXE_ICON_RC@"
IDR_GCPAD RCDATA "@GCPAD_RC@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @RC_VERSION@
 PRODUCTVERSION @RC_VERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Wario World Recomp"
            VALUE "FileVersion", "@WARIO_RELEASE_VERSION@"
            VALUE "ProductName", "Wario World Recomp (unofficial fan project)"
            VALUE "ProductVersion", "@WARIO_RELEASE_VERSION@"
            VALUE "OriginalFilename", "WarioWorldRecomp.exe"
            VALUE "LegalCopyright", "GPLv3 project code; not affiliated with Nintendo"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
